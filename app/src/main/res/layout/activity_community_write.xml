<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/community_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/community_ic_back"
            android:contentDescription="뒤로" />
        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="글쓰기"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/community_ink" />
        <Button
            android:id="@+id/btnSave"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:text="등록"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/community_pink" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="카테고리 선택"
                android:textSize="13sp"
                android:textColor="@color/community_ink"
                android:textStyle="bold"
                android:labelFor="@id/spinnerCategory" />
            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/community_input"
                android:paddingStart="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="제목을 입력하세요."
                android:textSize="13sp"
                android:textColor="@color/community_ink"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etTitle" />
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/community_input"
                android:hint="제목을 입력하세요. (최대 50자)"
                android:textSize="14sp"
                android:textColor="@color/community_ink"
                android:textColorHint="@color/community_muted"
                android:inputType="textCapSentences"
                android:maxLength="50"
                android:maxLines="1" />
            <TextView
                android:id="@+id/tvTitleCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/50"
                android:textSize="11sp"
                android:textColor="@color/community_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내용을 입력하세요."
                android:textSize="13sp"
                android:textColor="@color/community_ink"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:labelFor="@id/etContent" />
            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:gravity="top|start"
                android:background="@drawable/community_input"
                android:hint="다른 부모님들과 유용한 정보를 나눠보세요 :)"
                android:textSize="14sp"
                android:textColor="@color/community_ink"
                android:textColorHint="@color/community_muted"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="5000" />
            <TextView
                android:id="@+id/tvContentCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/5000"
                android:textSize="11sp"
                android:textColor="@color/community_muted" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="휴대폰 사진 첨부는 아직 지원하지 않아요. 아래 대표 이미지를 선택해 주세요."
                android:textSize="12sp"
                android:textColor="@color/community_muted" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="@color/community_line" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="대표 이미지 선택"
                android:textSize="13sp"
                android:textColor="@color/community_ink"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="게시글 목록에 표시할 이미지를 선택해 주세요."
                android:textSize="12sp"
                android:textColor="@color/community_muted" />
            <GridView
                android:id="@+id/imageGrid"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:numColumns="5"
                android:verticalSpacing="8dp"
                android:horizontalSpacing="5dp"
                android:stretchMode="columnWidth" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="게시글 목록 미리보기"
                android:textSize="13sp"
                android:textColor="@color/community_ink"
                android:textStyle="bold"
                android:layout_marginTop="18dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="@drawable/community_card">
                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="선택한 대표 이미지" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/tvPreviewCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:background="@drawable/community_chip_off"
                        android:textColor="@color/community_pink"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvPreviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/community_ink"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <Spinner
                android:id="@+id/spinnerChildAge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="공개할 자녀 나이 선택" />
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/community_pink"
                android:accessibilityLiveRegion="polite" />
            <Button
                android:id="@+id/btnSaveBottom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="등록하기"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/community_pink" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
