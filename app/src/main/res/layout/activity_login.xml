<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="28dp"
        android:paddingEnd="30dp"
        android:paddingBottom="28dp">
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">
            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:contentDescription="@string/app_name" android:src="@drawable/maru_mark" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="24dp" android:gravity="center" android:text="@string/login_title" android:textColor="#464646" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/email_hint" android:textColor="#727272" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/editLoginEmail" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_auth_input" android:hint="@string/email_entry_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_hint" android:textColor="#727272" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/editLoginPassword" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_auth_input" android:hint="@string/password_entry_hint" android:inputType="textPassword" android:autofillHints="password" android:maxLines="1" android:textSize="16sp" />
            <Button android:id="@+id/buttonLogin" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="16dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/login" android:textSize="16sp" />
            <Button android:id="@+id/btnGoogleLogin" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="10dp" android:background="@drawable/bg_choice_button_outline" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FF9494" android:textAllCaps="false" android:text="@string/google_login" android:textSize="16sp" />
            <Button android:id="@+id/buttonGoSignup" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="10dp" android:background="@drawable/bg_choice_button_outline" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FF9494" android:textAllCaps="false" android:text="@string/go_signup" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/app_name" android:src="@drawable/maru_mark" />
            <TextView android:id="@+id/textSignupTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/signup_title" android:textColor="#464646" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:gravity="center" android:text="@string/signup_subtitle" android:textColor="#FF9494" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/email_hint" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupEmail" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_auth_input" android:hint="@string/email_entry_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_hint" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupPassword" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_auth_input" android:hint="@string/password_entry_hint" android:inputType="textPassword" android:autofillHints="newPassword" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_confirm_hint" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupPasswordConfirm" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_auth_input" android:hint="@string/password_confirm_entry_hint" android:inputType="textPassword" android:autofillHints="newPassword" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signup_username_label" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupName" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_auth_input" android:hint="@string/signup_username_hint" android:inputType="textPersonName" android:maxLines="1" android:textSize="16sp" />
            <Button android:id="@+id/buttonSignup" android:layout_width="match_parent" android:layout_height="51dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/signup_next" android:textSize="16sp" />
            <Button android:id="@+id/buttonBackLogin" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:background="@drawable/bg_choice_button_outline" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#B7B0B0" android:textAllCaps="false" android:text="@string/back" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutChildSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/app_name" android:src="@drawable/maru_mark" />
            <TextView android:id="@+id/textChildSignupTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/signup_title" android:textColor="#464646" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/child_signup_title" android:textColor="#FF9494" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="30dp" android:text="@string/child_signup_description" android:textColor="#9E9E9E" android:textSize="20sp" />
            <Button android:id="@+id/buttonChildAdd" android:layout_width="match_parent" android:layout_height="51dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/add_child" android:textSize="16sp" />
            <Button android:id="@+id/buttonSignupComplete" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="38dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/signup" android:textSize="16sp" />
            <Button android:id="@+id/buttonChildBack" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:background="@drawable/bg_choice_button_outline" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#B7B0B0" android:textAllCaps="false" android:text="@string/back" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layoutHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="#242424" android:textSize="24sp" android:text="@string/auth_home_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="#242424" android:textSize="16sp" android:id="@+id/textUserEmail" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="#242424" android:textSize="16sp" android:text="@string/auth_home_description" />
            <Button android:id="@+id/buttonLogout" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="12dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/logout" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progressAuth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
