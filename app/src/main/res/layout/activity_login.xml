<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="28dp"
        android:paddingEnd="30dp"
        android:paddingBottom="28dp">
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">
            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:contentDescription="@string/app_name" android:src="@drawable/maru_mark" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="24dp" android:gravity="center" android:text="@string/login_title" android:textColor="#464646" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/email_hint" android:textColor="#727272" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/editLoginEmail" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_auth_input" android:hint="@string/email_entry_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_hint" android:textColor="#727272" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/editLoginPassword" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_auth_input" android:hint="@string/password_entry_hint" android:inputType="textPassword" android:autofillHints="password" android:maxLines="1" android:textSize="16sp" />
            <Button android:id="@+id/buttonLogin" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="16dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/login" android:textSize="16sp" />
            <Button android:id="@+id/btnGoogleLogin" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="10dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/google_login" android:textSize="16sp" />
            <Button android:id="@+id/buttonGoSignup" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="10dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/go_signup" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/app_name" android:src="@drawable/maru_mark" />
            <TextView android:id="@+id/textSignupTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/signup_title" android:textColor="#464646" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:gravity="center" android:text="@string/signup_subtitle" android:textColor="#FF9494" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/email_hint" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupEmail" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_auth_input" android:hint="@string/email_entry_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_hint" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupPassword" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_auth_input" android:hint="@string/password_entry_hint" android:inputType="textPassword" android:autofillHints="newPassword" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_confirm_hint" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupPasswordConfirm" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_auth_input" android:hint="@string/password_confirm_entry_hint" android:inputType="textPassword" android:autofillHints="newPassword" android:maxLines="1" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signup_username_label" android:textColor="#727272" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/editSignupName" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_auth_input" android:hint="@string/signup_username_hint" android:inputType="textPersonName" android:maxLines="1" android:textSize="16sp" />
            <Button android:id="@+id/buttonSignup" android:layout_width="match_parent" android:layout_height="51dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/signup_next" android:textSize="16sp" />
            <Button android:id="@+id/buttonBackLogin" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="8dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/back" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutChildSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout android:id="@+id/childListStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/app_name" android:src="@drawable/maru_mark" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/child_signup_title" android:textColor="#292929" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:gravity="center" android:text="@string/child_signup_description" android:textColor="#858585" android:textSize="14sp" />
                <Button android:id="@+id/buttonChildAdd" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/add_child" android:textSize="15sp" />
                <LinearLayout android:id="@+id/layoutPendingChildren" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
                <Button android:id="@+id/buttonSignupComplete" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="24dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/child_signup_continue" android:textSize="16sp" />
                <Button android:id="@+id/buttonChildBack" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/back" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/childBasicStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:id="@+id/childStepIndicators" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginBottom="22dp" android:orientation="horizontal">
                    <View android:id="@+id/childStepBar1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="#FF777E" />
                    <View android:id="@+id/childStepBar2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="#FFE4E2" />
                    <View android:id="@+id/childStepBar3" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#FFE4E2" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/child_basic_title" android:textColor="#292929" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:layout_marginBottom="15dp" android:text="@string/child_basic_description" android:textColor="#858585" android:textSize="14sp" />
                <FrameLayout android:layout_width="108dp" android:layout_height="108dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="14dp" android:background="@drawable/bg_circle_white">
                    <ImageView android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="center" android:contentDescription="@string/child_avatar_description" android:src="@drawable/ic_person" android:tint="#FF9A9E" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/child_name_label" android:textColor="#5C5C5C" android:textSize="14sp" android:textStyle="bold" />
                <EditText android:id="@+id/editChildName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_auth_input" android:hint="@string/child_name_hint" android:inputType="textPersonName" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/child_birthdate_label" android:textColor="#5C5C5C" android:textSize="14sp" android:textStyle="bold" />
                <Button android:id="@+id/buttonChildBirthDate" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_auth_input" android:backgroundTint="@null" android:stateListAnimator="@null" android:gravity="center_vertical|start" android:paddingStart="14dp" android:text="@string/child_birthdate" android:textAllCaps="false" android:textColor="#777777" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/child_gender_label" android:textColor="#5C5C5C" android:textSize="14sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/radioChildGender" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <RadioButton android:id="@+id/radioChildGenderGirl" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:buttonTint="#FF858B" android:text="@string/child_gender_girl" android:textColor="#555555" android:textSize="14sp" />
                    <RadioButton android:id="@+id/radioChildGenderBoy" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:buttonTint="#FF858B" android:text="@string/child_gender_boy" android:textColor="#555555" android:textSize="14sp" />
                </RadioGroup>
                <Button android:id="@+id/buttonChildBasicNext" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/next" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
                <Button android:id="@+id/buttonChildBasicBack" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/back" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/childInterestsStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginBottom="22dp" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="#FF777E" />
                    <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="#FF777E" />
                    <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#FFE4E2" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/child_interests_title" android:textColor="#292929" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:text="@string/child_interests_description" android:textColor="#858585" android:textSize="14sp" />
                <CheckBox android:id="@+id/checkInterestArt" android:layout_width="match_parent" android:layout_height="50dp" android:buttonTint="#FF858B" android:text="@string/interest_art" android:textColor="#555555" android:textSize="15sp" />
                <CheckBox android:id="@+id/checkInterestBooks" android:layout_width="match_parent" android:layout_height="50dp" android:buttonTint="#FF858B" android:text="@string/interest_books" android:textColor="#555555" android:textSize="15sp" />
                <CheckBox android:id="@+id/checkInterestNature" android:layout_width="match_parent" android:layout_height="50dp" android:buttonTint="#FF858B" android:text="@string/interest_nature" android:textColor="#555555" android:textSize="15sp" />
                <CheckBox android:id="@+id/checkInterestSports" android:layout_width="match_parent" android:layout_height="50dp" android:buttonTint="#FF858B" android:text="@string/interest_sports" android:textColor="#555555" android:textSize="15sp" />
                <CheckBox android:id="@+id/checkInterestMusic" android:layout_width="match_parent" android:layout_height="50dp" android:buttonTint="#FF858B" android:text="@string/interest_music" android:textColor="#555555" android:textSize="15sp" />
                <CheckBox android:id="@+id/checkInterestSocial" android:layout_width="match_parent" android:layout_height="50dp" android:buttonTint="#FF858B" android:text="@string/interest_social" android:textColor="#555555" android:textSize="15sp" />
                <Button android:id="@+id/buttonChildInterestNext" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/next" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
                <Button android:id="@+id/buttonChildInterestBack" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/back" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/childTraitsStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginBottom="22dp" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="#FF777E" />
                    <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="#FF777E" />
                    <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#FF777E" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/child_traits_title" android:textColor="#292929" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:text="@string/child_traits_description" android:textColor="#858585" android:textSize="14sp" />
                <CheckBox android:id="@+id/checkTraitActive" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="#FF858B" android:text="@string/trait_active" android:textColor="#555555" android:textSize="14sp" />
                <CheckBox android:id="@+id/checkTraitCalm" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="#FF858B" android:text="@string/trait_calm" android:textColor="#555555" android:textSize="14sp" />
                <CheckBox android:id="@+id/checkTraitCurious" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="#FF858B" android:text="@string/trait_curious" android:textColor="#555555" android:textSize="14sp" />
                <CheckBox android:id="@+id/checkTraitSocial" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="#FF858B" android:text="@string/trait_social" android:textColor="#555555" android:textSize="14sp" />
                <EditText android:id="@+id/editChildTraitNote" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="8dp" android:background="@drawable/bg_auth_input" android:gravity="top" android:hint="@string/child_traits_note_hint" android:inputType="textMultiLine" android:padding="12dp" android:textSize="14sp" />
                <Button android:id="@+id/buttonChildTraitsNext" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/next" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
                <Button android:id="@+id/buttonChildTraitsBack" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/back" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/childDoneStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
                <ImageView android:layout_width="148dp" android:layout_height="148dp" android:layout_marginTop="36dp" android:contentDescription="@string/child_done_image_description" android:src="@drawable/img_parent_child" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/child_done_title" android:textColor="#292929" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/textChildDoneDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:gravity="center" android:text="@string/child_done_description" android:textColor="#858585" android:textSize="14sp" />
                <Button android:id="@+id/buttonChildAddAnother" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/child_add_another" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
                <Button android:id="@+id/buttonChildDoneStart" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="10dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:text="@string/start" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/layoutHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="#242424" android:textSize="24sp" android:text="@string/auth_home_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="#242424" android:textSize="16sp" android:id="@+id/textUserEmail" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="#242424" android:textSize="16sp" android:text="@string/auth_home_description" />
            <Button android:id="@+id/buttonLogout" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="12dp" android:background="@drawable/bg_choice_button_primary" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textAllCaps="false" android:text="@string/logout" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progressAuth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
