<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupChoiceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/onboarding_image_description"
        android:scaleType="centerCrop"
        android:src="@drawable/main" />
    <LinearLayout
        android:id="@+id/signupChoicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_auth_choice_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="29dp"
        android:paddingEnd="24dp"
        android:paddingBottom="29dp">
        <TextView
            android:id="@+id/textSignupChoiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/signup_choice_title"
            android:textColor="#5C5C5C"
            android:textSize="24sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/buttonSignupEmail"
            android:layout_width="280dp"
            android:layout_height="51dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_choice_button_outline"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/email_signup"
            android:textAllCaps="false"
            android:textColor="#FF9494"
            android:textSize="20sp" />
        <Button
            android:id="@+id/buttonSignupEmailAlternative"
            android:layout_width="280dp"
            android:layout_height="51dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_choice_button_outline"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/email_signup"
            android:textAllCaps="false"
            android:textColor="#FF9494"
            android:textSize="20sp" />
        <Button
            android:id="@+id/buttonSignupChoiceBack"
            android:layout_width="280dp"
            android:layout_height="51dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_choice_button_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
