<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_wallpaper">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="101dp"
            android:layout_height="101dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/maru_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="마루"
            android:textColor="#252525"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="0dp"
            android:text="@string/splash_tagline"
            android:textColor="#ADADAD"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layoutSessionLoading"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="52dp"
        android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <ProgressBar android:layout_width="28dp" android:layout_height="28dp" android:indeterminateTint="@color/maru_pink" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="로그인 상태를 확인하는 중이에요."
            android:textColor="@color/text_sub" android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
