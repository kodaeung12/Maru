<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/community_sheet">
    <TextView android:id="@+id/tvPostTitle" style="@style/CommunityHeading"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
        android:paddingBottom="16dp" />
    <TextView android:id="@+id/btnReport" style="@style/CommunityText"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="신고하기" android:textColor="@color/community_action"
        android:gravity="center_vertical" android:clickable="true" android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />
    <TextView android:id="@+id/btnEdit" style="@style/CommunityText"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="수정하기" android:gravity="center_vertical"
        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
    <TextView android:id="@+id/btnDelete" style="@style/CommunityText"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="삭제하기" android:textColor="@color/community_action"
        android:gravity="center_vertical" android:clickable="true" android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/community_line" />
    <TextView android:id="@+id/btnClose" style="@style/CommunityMuted"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="닫기" android:gravity="center" android:clickable="true" android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />
</LinearLayout>
