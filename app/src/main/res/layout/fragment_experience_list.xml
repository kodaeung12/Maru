<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/title_home"
            android:focusable="true"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="@color/text_dark"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textExperienceTitle"
            android:text="@string/title_experience"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/experienceListControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_experience_list_control"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/community_pink"
            android:hint="@string/experience_list_search_hint"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:singleLine="true"
            android:textColor="@color/community_ink"
            android:textColorHint="@color/community_muted"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <android.widget.Button
                    android:id="@+id/filterRegion"
                    style="@style/CommunityCategoryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_experience_list_filter"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:singleLine="true"
                    android:stateListAnimator="@null"
                    android:text="@string/experience_list_filter_region"
                    android:textAllCaps="false"
                    android:textStyle="normal" />

                <android.widget.Button
                    android:id="@+id/filterPeriod"
                    style="@style/CommunityCategoryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_experience_list_filter"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:singleLine="true"
                    android:stateListAnimator="@null"
                    android:text="@string/experience_list_filter_period"
                    android:textAllCaps="false"
                    android:textStyle="normal" />

                <android.widget.Button
                    android:id="@+id/filterCategory"
                    style="@style/CommunityCategoryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_experience_list_filter"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:singleLine="true"
                    android:stateListAnimator="@null"
                    android:text="@string/experience_list_filter_category"
                    android:textAllCaps="false"
                    android:textStyle="normal" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:minHeight="48dp"
            android:background="@drawable/community_banner"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="5dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/experience_list_recommend"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/experience_list_recommend_description"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/community_pink" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSimilarEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:backgroundTint="@null"
                android:contentDescription="@string/experience_list_recommend_accessibility" />
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/textSearchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/text_dark" />

    <Button
        android:id="@+id/buttonRetrySearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_retry"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerExperience"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
