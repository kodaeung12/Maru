<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="☺" android:gravity="center" android:textSize="23sp" android:background="@drawable/community_avatar" android:textColor="@color/community_action" android:importantForAccessibility="no" style="@style/CommunityText" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/tvAuthor" android:text="" android:layout_weight="1" style="@style/CommunityFieldLabel" />
                <TextView android:layout_width="44dp" android:layout_height="32dp" android:id="@+id/btnDelete" android:text="삭제" android:gravity="center" android:textColor="@color/community_action" android:visibility="gone" android:clickable="true" android:focusable="true" style="@style/CommunityMuted" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvChildAge" android:text="" android:visibility="gone" style="@style/CommunityMuted" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvContent" android:text="" android:textSize="13sp" android:lineSpacingExtra="6dp" android:textIsSelectable="true" style="@style/CommunityText" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvDate" android:text="" android:textSize="10sp" style="@style/CommunityMuted" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/community_line" android:layout_marginVertical="12dp" />
</LinearLayout>