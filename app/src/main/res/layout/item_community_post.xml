<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp" android:minHeight="108dp" android:paddingHorizontal="14dp" android:paddingVertical="11dp" android:background="@drawable/community_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical">
    <ImageView android:layout_width="85dp" android:layout_height="85dp" android:id="@+id/ivRepresentative" android:scaleType="fitCenter" android:contentDescription="게시글 대표 이미지" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="22dp" android:id="@+id/tvCategory" android:text="" android:paddingHorizontal="12dp" android:gravity="center" android:background="@drawable/community_badge" android:textColor="#FFFFFF" android:textSize="11sp" style="@style/CommunityFieldLabel" />
        <Space android:layout_width="1dp" android:layout_height="7dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvTitle" android:text="" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" style="@style/CommunityHeading" />
        <Space android:layout_width="1dp" android:layout_height="3dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvOwner" android:text="" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" style="@style/CommunityMuted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvDate" android:text="" android:visibility="gone" style="@style/CommunityMuted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvChildAge" android:text="" android:textSize="10sp" android:visibility="gone" style="@style/CommunityMuted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="center_vertical">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/community_figma_heart" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tvStats" android:text="0" android:textColor="@color/community_pink" android:textSize="12sp" android:layout_marginStart="2dp" style="@style/CommunityMuted" />
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/community_figma_chat" android:importantForAccessibility="no" android:layout_marginStart="7dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tvComments" android:text="댓글" android:textColor="@color/community_pink" android:textSize="12sp" android:layout_marginStart="2dp" style="@style/CommunityMuted" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/tvViews" android:text="" android:layout_weight="1" android:gravity="end" android:textSize="10sp" style="@style/CommunityMuted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>