<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/imageMood" android:layout_width="36dp" android:layout_height="36dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/textMood" android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center" android:textSize="12sp" android:textColor="#898589" />
</LinearLayout>
