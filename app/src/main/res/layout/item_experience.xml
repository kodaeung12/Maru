<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:padding="1dp"
    android:background="@drawable/community_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/imageExperience"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#DDEBE9"
        android:scaleType="centerCrop"
        android:contentDescription="체험 대표 이미지" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="과학 체험"
            android:textSize="11sp"
            android:background="@drawable/community_chip_off"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/community_pink" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="어린이 과학 체험전"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/community_ink"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="서울 과학관"
            android:textSize="11sp"
            android:textColor="@color/community_muted"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="2026.11.10"
            android:textSize="11sp"
            android:textColor="@color/community_muted"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
