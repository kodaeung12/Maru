<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="248dp" android:layout_height="156dp"
    android:orientation="vertical" android:layout_marginEnd="12dp" android:padding="16dp"
    android:clickable="true" android:focusable="true" android:background="@drawable/bg_round_20" android:backgroundTint="@color/page_bg" android:foreground="?attr/selectableItemBackground">
    <TextView android:id="@+id/textHomePostCategory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/maru_pink" android:textSize="12sp" />
    <TextView android:id="@+id/textHomePostTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:minLines="2" android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/textHomePostTime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/text_sub" android:textSize="12sp" />
</LinearLayout>
