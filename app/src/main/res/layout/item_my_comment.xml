<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginBottom="12dp" android:padding="16dp"
    android:background="@drawable/community_card" android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <TextView android:id="@+id/textPostTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:maxLines="2" android:ellipsize="end" style="@style/CommunityHeading" />
    <TextView android:id="@+id/textComment" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="13sp" android:maxLines="4" android:ellipsize="end"
        android:lineSpacingExtra="4dp" style="@style/CommunityText" />
    <TextView android:id="@+id/textDate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="11sp" style="@style/CommunityMuted" />
</LinearLayout>
