<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/ivOnboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_onboarding_image"
        android:clipToOutline="true"
        android:contentDescription="@string/onboarding_image_description"
        android:scaleType="centerCrop"
        android:src="@drawable/boarding1" />

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/onboarding_title_1"
        android:textColor="#252525"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOnboardingDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:text="@string/onboarding_description_1"
        android:textColor="#888888"
        android:textSize="20sp" />

</LinearLayout>
