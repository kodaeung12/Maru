<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/experienceMapZoomControls"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_margin="12dp"
    android:background="@drawable/bg_experience_map_zoom"
    android:elevation="4dp"
    android:orientation="vertical"
    android:visibility="gone">

    <android.widget.Button
        android:id="@+id/buttonExperienceZoomIn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/experience_map_zoom_in"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <android.widget.Button
        android:id="@+id/buttonExperienceZoomOut"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/experience_map_zoom_out"
        android:padding="0dp"
        android:text="−"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />
</LinearLayout>
