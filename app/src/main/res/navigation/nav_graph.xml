<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.project.maru.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_experience" app:destination="@id/experienceFragment" />
        <action android:id="@+id/action_home_to_ageEdu" app:destination="@id/ageEduFragment" />
        <action android:id="@+id/action_home_to_safety" app:destination="@id/safetyFragment" />
        <action android:id="@+id/action_home_to_search" app:destination="@id/searchFragment" />
        <action android:id="@+id/action_home_to_favorites" app:destination="@id/favoritesFragment" />
    </fragment>

    <fragment
        android:id="@+id/experienceFragment"
        android:name="com.project.maru.experience.list.ExperienceListFragment"
        android:label="@string/title_experience"
        tools:layout="@layout/fragment_experience_list">
        <argument
            android:name="category"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/ageEduFragment"
        android:name="com.project.maru.AgeEducationFragment"
        android:label="@string/title_age_edu"
        tools:layout="@layout/fragment_age_edu">
        <argument
            android:name="category"
            android:defaultValue="6"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/safetyFragment"
        android:name="com.project.maru.PlaceholderFragment"
        android:label="@string/title_safety"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.project.maru.experience.list.ExperienceListFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_experience_list" />

    <fragment
        android:id="@+id/communityFragment"
        android:name="com.project.maru.CommunityFragment"
        android:label="@string/title_community"
        tools:layout="@layout/fragment_community" />

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.project.maru.MyPageFragment"
        android:label="@string/title_mypage"
        tools:layout="@layout/fragment_mypage">
        <action
            android:id="@+id/action_myPage_to_myInfo"
            app:destination="@id/myInfoFragment" />
    </fragment>

    <fragment
        android:id="@+id/myInfoFragment"
        android:name="com.project.maru.MyInfoFragment"
        android:label="@string/my_info_title"
        tools:layout="@layout/fragment_my_info" />

    <fragment android:id="@+id/settingsFragment" android:name="com.project.maru.SettingsFragment"
        android:label="@string/settings" tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.project.maru.experience.list.ExperienceListFragment"
        android:label="@string/title_favorites"
        tools:layout="@layout/fragment_experience_list" />
</navigation>
