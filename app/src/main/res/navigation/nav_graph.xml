<?xml version="1.0" encoding="utf-8"?>
<!-- 화면 지도 (Navigation Graph)
     Android Studio 에서 이 파일을 열고 [Design] 탭을 누르면 화면 연결을 그림으로 볼 수 있어요. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- 홈 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.maru.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_experience" app:destination="@id/experienceFragment" />
        <action android:id="@+id/action_home_to_ageEdu" app:destination="@id/ageEduFragment" />
        <action android:id="@+id/action_home_to_safety" app:destination="@id/safetyFragment" />
        <action android:id="@+id/action_home_to_search" app:destination="@id/searchFragment" />
        <action android:id="@+id/action_home_to_favorites" app:destination="@id/favoritesFragment" />
    </fragment>

    <!-- 1. 체험·행사 (category: 문화·예술 / 자연·생태 등 어떤 버튼으로 왔는지) -->
    <fragment
        android:id="@+id/experienceFragment"
        android:name="com.example.maru.ExperienceFragment"
        android:label="@string/title_experience"
        tools:layout="@layout/fragment_experience">
        <argument
            android:name="category"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <!-- 2. 연령별 교육 -->
    <fragment
        android:id="@+id/ageEduFragment"
        android:name="com.example.maru.AgeEduFragment"
        android:label="@string/title_age_edu"
        tools:layout="@layout/fragment_age_edu" />

    <!-- 3. 준비물과 안전수칙 -->
    <fragment
        android:id="@+id/safetyFragment"
        android:name="com.example.maru.SafetyFragment"
        android:label="@string/title_safety"
        tools:layout="@layout/fragment_safety" />

    <!-- 4. 검색 -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.maru.SearchFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_search" />

    <!-- 5. 커뮤니티 -->
    <fragment
        android:id="@+id/communityFragment"
        android:name="com.example.maru.CommunityFragment"
        android:label="@string/title_community"
        tools:layout="@layout/fragment_community" />

    <!-- 6. 마이페이지 -->
    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.example.maru.MyPageFragment"
        android:label="@string/title_mypage"
        tools:layout="@layout/fragment_mypage" />

    <!-- 7. 즐겨찾기 -->
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.maru.FavoritesFragment"
        android:label="@string/title_favorites"
        tools:layout="@layout/fragment_favorites" />
</navigation>
