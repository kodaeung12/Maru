<?xml version="1.0" ?>
<resources>
    

    <style name="DiaryText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    

    <style name="DiaryHeading" parent="DiaryText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    

    <style name="DiaryMuted" parent="DiaryText">
        <item name="android:textColor">#898589</item>
        <item name="android:textSize">12sp</item>
    </style>
    

    <style name="DiaryButton" parent="DiaryText">
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/diary_primary</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    

</resources>
